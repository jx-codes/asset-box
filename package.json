{
  "name": "asset-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.7",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:uat": "CLOUDFLARE_ENV=uat vite build && CLOUDFLARE_ENV=uat wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=prod vite build && CLOUDFLARE_ENV=prod wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ASSET_BOX_DB --local",
    "db:migrate:uat": "wrangler d1 migrations apply ASSET_BOX_DB --env uat --remote",
    "db:migrate:prod": "wrangler d1 migrations apply ASSET_BOX_DB --env prod --remote",
    "asset-box": "bun src/cli/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/zod-openapi": "^1.5.1",
    "@legendapp/state": "^3.0.0-beta.48",
    "@scalar/hono-api-reference": "^0.11.11",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "errore": "^0.14.1",
    "hono": "^4.12.30",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@fast-check/vitest": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
